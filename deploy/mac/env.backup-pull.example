# Copy to the repo root on your Mac as .env.backup-pull, then: chmod 600 .env.backup-pull
# Read by deploy/mac/pull-backups.sh. All values are optional; defaults shown.

# SSH login on the VPS and a key that works without a passphrase prompt (BatchMode).
BACKUP_SSH_HOST=ernesto@89.117.37.202
BACKUP_SSH_KEY=$HOME/.ssh/g3-backup

# Backup folder on the VPS (BACKUP_DIR in the server's .env.ops; relative paths are from ernesto's home).
BACKUP_REMOTE_DIR=backups/nacho-site

# Where backups land on the Mac and how many days to keep (same 14 days as the VPS).
BACKUP_LOCAL_DIR=$HOME/Backups/novetesco
BACKUP_LOCAL_RETENTION_DAYS=14

# healthchecks.io-style ping URL; you get an email when pulls fail or stop (e.g. Mac off for days).
BACKUP_PULL_HEALTHCHECK_URL=
