# Copy to the app directory on the VPS as .env.ops, then: chmod 600 .env.ops
# Read by deploy/vps/backup.sh, restore.sh, monitor.sh, and logs.sh. All values are optional.

# Local backup folder (outside the git checkout) and how many days to keep.
BACKUP_DIR=/home/ernesto/backups/nacho-site
BACKUP_RETENTION_DAYS=14

# Off-server copy: your Mac pulls this folder (deploy/mac/pull-backups.sh), so leave rclone empty.
# Optional extra cloud copy with rclone (configure first with `rclone config`), e.g. b2:novetesco-backups/nacho-site
BACKUP_RCLONE_REMOTE=
BACKUP_REMOTE_RETENTION_DAYS=30

# healthchecks.io-style ping URLs. You get an email when a run fails or stops reporting.
BACKUP_HEALTHCHECK_URL=
MONITOR_HEALTHCHECK_URL=

# monitor.sh thresholds (set MONITOR_BACKUP_MAX_AGE_HOURS or MONITOR_MAX_DAILY_ERRORS to 0 to disable).
MONITOR_DISK_MAX_PERCENT=85
MONITOR_TLS_MIN_DAYS=14
MONITOR_BACKUP_MAX_AGE_HOURS=26
MONITOR_MAX_DAILY_ERRORS=20
