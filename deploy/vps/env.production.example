# Copy on the VPS to /var/www/nacho-site/.env.production
# chmod 600 .env.production

APP_NAME="NACHO Vehicle Inspection"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://noblevehicletestingcompany.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Generate on VPS: docker compose ... exec app php artisan key:generate --show
# Then paste here before first `up` (or let entrypoint create storage/.app_key on first boot).
APP_KEY=

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=nacho_vehicle_inspection
DB_USERNAME=nacho
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

DB_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Until Hostinger SMTP is configured (Step 47+ / later)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@noblevehicletestingcompany.com"
MAIL_FROM_NAME="${APP_NAME}"

# First deploy only — set false after successful seed
RUN_DB_SEED=true
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

BOOKING_NOTIFICATION_EMAIL=bookings@noblevehicletestingcompany.com
CONTACT_NOTIFICATION_EMAIL=contact@noblevehicletestingcompany.com

WHATSAPP_NUMBER=
GOOGLE_MAPS_EMBED_KEY=

# Not used when nginx binds 127.0.0.1:8083 (production override)
DOCKER_HTTP_PORT=8083
