# Copy to .env when running the stack outside Compose, or rely on docker-compose environment.
# For local Docker: docker compose --env-file .env.docker.example up --build

APP_NAME="NOVETESCO Vehicle Inspection"
APP_ENV=local
# Leave empty on first run; entrypoint runs `key:generate` and persists to storage/.app_key.
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=nacho_vehicle_inspection
DB_USERNAME=nacho
DB_PASSWORD=nacho_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@nacho.local"
MAIL_FROM_NAME="${APP_NAME}"

RUN_DB_SEED=true
SEED_ADMIN_PASSWORD=NachoAdmin2026!
BOOKING_NOTIFICATION_EMAIL=bookings@nacho.local
CONTACT_NOTIFICATION_EMAIL=contact@nacho.local

DOCKER_HTTP_PORT=8080
DB_ROOT_PASSWORD=nacho_root
